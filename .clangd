CompileFlags:
  # compile_flags.txt (generated by `just clangd`) provides include paths.
  # Flags here supplement those.
  Add:
    - -std=c++17
    - -x
    - cuda
    - --cuda-gpu-arch=sm_89
    - -DCUDA_HAS_FP16=1
    - -DCUDA_HAS_BF16=1
    - -U__CUDA_NO_HALF_OPERATORS__
    - -U__CUDA_NO_HALF_CONVERSIONS__
    - -U__CUDA_NO_HALF2_OPERATORS__
    - --no-cuda-version-check
  Compiler: clang++

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - pp_file_not_found          # CUDA runtime headers may not resolve fully
    - undeclared_var_use_suggest # noinline undefined in clangd device-side pass
