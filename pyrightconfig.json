{
  "include": [
    "sources",
    "tests",
    "examples",
    "docs/5.notebooks/tutorials/_build.py",
    "docs/5.notebooks/embedding_filters/_build.py"
  ],
  "exclude": [
    ".venv",
    ".uv_cache",
    "**/__pycache__"
  ],
  "pythonVersion": "3.13",
  "typeCheckingMode": "basic",
  "//": "tensordict tensorclass / TensorDict.__getattr__ pattern fools Pyright;",
  "//2": "downgrade the noisy reports to information so real errors still show.",
  "reportCallIssue": "information",
  "reportArgumentType": "information",
  "reportAttributeAccessIssue": "information",
  "reportAssignmentType": "information",
  "reportReturnType": "information",
  "reportMissingImports": "information",
  "reportUnknownParameterType": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownVariableType": "none",
  "reportGeneralTypeIssues": "warning"
}
